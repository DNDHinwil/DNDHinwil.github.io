@using DNDHinwil.Models
@typeparam T where T : Codespirals.Base.IIdentifiable, Codespirals.Base.INameable

<div class="selectable">
    <button class="left-button" @onclick="ToggleSelect">@(Model.Selected ? Constants.Symbol_Equipped : Constants.Symbol_Unequipped)</button>
    <div>@Model.Item.Name</div>
</div>

@code {
    [Parameter]
    public required Selectable<T> Model { get; set; }

    private void ToggleSelect()
        => Model.Selected = !Model.Selected;
}
