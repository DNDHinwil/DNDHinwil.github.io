<div class="equipment-item">
    <h4>@Model.Name</h4>
    <div class="quantity">@(Model.Quantity > 0 && !HideQuantity ? $"x{Model.Quantity}" : "")</div>
    <div class="weight">@(Model.Weight > 0 ? $"{Model.Weight * Model.Quantity} ⚖" : "")</div>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="equipment-effect" style="grid-column:span 3;">@Model.Description</div>
    }
    @if (Model.Effects.Any())
    {
        <div class="effects" style="grid-column:span 3;">
            @foreach (var effect in Model.Effects)
            {
                <EffectView Model="effect" Modifiers="Modifiers"></EffectView>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public required Equipment Model { get; set; }
    [Parameter]
    public List<Modifier>? Modifiers { get; set; }
    [Parameter]
    public bool HideQuantity { get; set; }
}
