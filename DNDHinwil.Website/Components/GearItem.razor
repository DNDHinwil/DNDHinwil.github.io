<div class="gear-item">
    <h4>@Model.Name</h4>
    @if (IsEquipped)
    {
        <div class="gear-label">
            @Text.Equipped
        </div>
    }
    else
    {
        <div></div>
    }
    <div style="text-align:right;">@(Model.Weight > 0 ? $"{Model.Weight} {Constants.Symbol_Weight}" : "")</div>

    <div class="gear-label" style="grid-column:span 2;">@(Slots?.FirstOrDefault(s => s.Id == Model.SlotId)?.Name ?? "")</div>
    <div style="text-align:right;">@(Model.Armor > 0 ? $"{Model.Armor} {Constants.Symbol_Armor}" : "")</div>

    <div style="grid-column:span 3;">@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "")</div>
    @if (Model.Effects.Any())
    {
        <div class="effects" style="grid-column:span 3;">
            @foreach (var effect in Model.Effects)
            {
                <EffectView Model="effect" Modifiers="Modifiers" Stats="Stats"></EffectView>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public required Gear Model { get; set; }
    [Parameter]
    public List<Modifier>? Modifiers { get; set; }
    [Parameter]
    public List<Stat>? Stats { get; set; }
    [Parameter]
    public List<GearSlot>? Slots { get; set; }
    [Parameter]
    public bool IsEquipped { get; set; }
}