<div class="gear-item">
    <h4>@Model.Name</h4>
    <div>@Model.Slot</div>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div style="grid-column:span 2;">@Model.Description</div>
    }
    @foreach (var effect in Model.Bonuses)
    {
        <div style="grid-column:span 2;">@effect.ToString()</div>
    }
</div>

@code {
    [Parameter]
    public required Gear Model { get; set; }

}