<div class="gear-item">
    <h4>@Model.Name</h4>
    <div>@Model.Slot.ToString()</div>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div></div>
        <div>@Model.Description</div>
    }
    @foreach (var effect in Model.Bonuses)
    {
        <div></div>
        <div>@effect.ToString()</div>
    }
</div>

@code {
    [Parameter]
    public required Gear Model { get; set; }

}