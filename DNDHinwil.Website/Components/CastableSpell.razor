<div class="spell">
    <h4>@Model.Name</h4>
    <div style="text-align:right;">@Text.ManaCost</div>
    <div style="text-align:right;">@Model.ManaCost</div>
    @foreach (var effect in Model.Effects)
    {
        <div style="grid-column:span 2;">@effect.ToString(CharacterStats.FirstOrDefault(s => s.Id == effect.BonusStatId), AbilityScoreTable)</div>
    }
</div>

@code {
    [Parameter]
    public required Spell Model { get; set; }
    [Parameter]
    public IEnumerable<Stat> CharacterStats { get; set; } = [];
    [Parameter]
    public AbilityScore[] AbilityScoreTable { get; set; } = [];
}
