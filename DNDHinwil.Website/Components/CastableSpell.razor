<div class="spell">
    <div>@Model.Name</div>
    <div>@Model.ManaCost</div>
    @foreach (var effect in Model.Effects)
    {
        <div>@effect.ToString(CharacterStats.FirstOrDefault(s => s.Id == effect.BonusStatId), AbilityScoreTable)</div>
    }
</div>

@code {
    [Parameter]
    public required Spell Model { get; set; }
    [Parameter]
    public IEnumerable<Stat> CharacterStats { get; set; } = [];
    [Parameter]
    public AbilityScore[] AbilityScoreTable { get; set; } = [];

}
