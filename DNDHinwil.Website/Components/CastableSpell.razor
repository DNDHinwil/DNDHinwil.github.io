<div class="spell">
    <div style="grid-column:span 2;">@Model.Name</div>
    @foreach (var effect in Model.Effects)
    {
        <div>@GetText(effect)</div>
    }
</div>

@code {
        [Parameter]
        public required Spell Model { get; set; }
        [Parameter]
        public IEnumerable<Stat> CharacterStats { get; set; } = [];
        [Parameter]
        public AbilityScore[] AbilityScoreTable { get; set; } = [];

    public string GetText(SpellEffect effect)
    {
        var stat = CharacterStats.FirstOrDefault(s => s.Id == (effect.BonusStatId ?? ""));
        if (stat is null)
            return effect.ToString();
        return effect.ToString(stat.GetModifier(AbilityScoreTable), stat.Short);
    }
}
