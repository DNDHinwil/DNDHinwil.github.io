@inject IContentService ContentService
@inject NavigationManager NavigationManager

<h1 class="navbar-brand"><NavLink href="/" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">DnD Hinwil</NavLink></h1>

@if (_links.Count > 0)
{
    <button title="Navigation menu" class="navbar-toggler" style="border-radius:0.25rem;" @onclick="ToggleNavMenu">
        <div class="line"></div>
        <div class="line"></div>
        <div class="line"></div>
    </button>

    <nav class="@NavMenuCssClass nav-scrollable">
        @foreach (var item in _links)
        {
            <NavLink href="@item.Link" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">@item.Name</NavLink>
        }
    </nav>
}

@code {
    public bool CollapseNavMenu { get; set; } = true;

    private string? NavMenuCssClass => CollapseNavMenu ? "collapse" : null;

    private List<LinkItem> _links = [];

    private void ToggleNavMenu()
    {
        CollapseNavMenu = !CollapseNavMenu;
    }
    private void CloseNavMenu()
    {
        CollapseNavMenu = true;
    }

    protected override async Task OnInitializedAsync()
    {
        _links = [.. await ContentService.GetNavItems()];
    }
}
