@inject IDataService ContentService
@inject NavigationManager NavigationManager

<h1 class="navbar-brand"><NavLink href="/" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">DnD Hinwil</NavLink></h1>

<button title="Navigation menu" class="navbar-toggler" style="border-radius:0.25rem;" @onclick="ToggleNavMenu">
    <div class="line"></div>
    <div class="line"></div>
    <div class="line"></div>
</button>

<nav class="@NavMenuCssClass nav-scrollable">
    <NavLink href="tracker" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">@Text.Tracker</NavLink>
    <NavLink href="stats" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">@Text.Stats</NavLink>
    <NavLink href="library" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">@Text.SpellLibrary</NavLink>
    <NavLink href="armory" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">@Text.Armory</NavLink>
    <NavLink href="characters" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">@Text.Characters</NavLink>
    <NavLink href="settings" Match="NavLinkMatch.All" tabindex="0" @onclick="CloseNavMenu">@Text.Settings</NavLink>
</nav>

@code {
    public bool CollapseNavMenu { get; set; } = true;

    private string? NavMenuCssClass => CollapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        CollapseNavMenu = !CollapseNavMenu;
    }
    private void CloseNavMenu()
    {
        CollapseNavMenu = true;
    }

}
