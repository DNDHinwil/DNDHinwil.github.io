@page "/"
@using System.Globalization
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - Home</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header class="title">
        <h2>Home</h2>
    </header>
    @if (_sessions.Count > 0 && _sessions.FirstOrDefault() != _activeSession)
    {
        <section>
            <h3>@Text.Sessions</h3>
            <InputSelect @bind-Value="_activeSession">
            @foreach (var session in _sessions)
            {
                <option value="@session">@session.StartTime.ToShortDateString()</option>
            }
            </InputSelect>
        </section>
    }
    @if (_activeSession is not null && _activeSession.Turns.Count > 2)
    {
        <section>
            <h3>@Text.Session</h3>
            <LineGraph Title="@Text.Turns" Min="(_activeSession.Turns.Min(t => t.Time!.Value.TotalMinutes) * 0.9d)" Max="(_activeSession.Turns.Min(t => t.Time!.Value.TotalMinutes) * 1.1d)" Points="TurnsToLineGraphPoints(_activeSession.Turns)"></LineGraph>
        </section>
    }
</div>

@code {
    private Settings _settings = new Settings();
    private Character _activeCharacter = new Character();
    private List<Session> _sessions = [];
    private Session? _activeSession;

    private string _timeFormat => @"mm\:ss";

    protected override void OnInitialized()
    {

    }

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        _activeCharacter = await ContentService.LoadCharacter(_settings.ActiveCharacter);
        if (string.IsNullOrWhiteSpace(_settings.ActiveCharacter))
        {
            _settings.ActiveCharacter = _activeCharacter.Id;
            await ContentService.SaveSettings(_settings);
        }
        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;

        _sessions = await ContentService.LoadSessions();
        _activeSession = _sessions.FirstOrDefault(x => x.EndTime is null);


    }
    private static IEnumerable<LineGraphPoint<double>> TurnsToLineGraphPoints(List<Turn> turns)
        => turns.Where(t => t.Time.HasValue).Select(t => new LineGraphPoint<double>() { Label = $"{Text.Turn} {turns.IndexOf(t)}", Value = t.Time!.Value.TotalMinutes });
}