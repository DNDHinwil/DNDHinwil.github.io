@page "/"
@using System.Globalization
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - Home</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header class="title">
        <h2>Home</h2>
    </header>
    <section>
        @if (_activeSession is null)
        {
            <h3>@Text.StartSession</h3>
            <button @onclick="async x => await StartSession()" style="width:100%;height:80px;">@Text.Start</button>
        }
        else
        {
            <h3>@Text.EndSession</h3>
            <button @onclick="async x => await EndSession()" style="width:100%;height:80px;">@Text.End</button>
        }
    </section>
    @if (_sessions.Count > 1)
    {
        <section>
            <h3>@Text.PastSessions</h3>
            <InputSelect @bind-Value="_selectedSession">
            @foreach (var session in _sessions)
            {
                <option value="@session">@session.StartTime.ToShortDateString()</option>
            }
            </InputSelect>
        </section>
    }
    @if (_selectedSession is not null && _selectedSession.Turns.Count > 2)
    {
        <section>
            <h3>@Text.Session</h3>
            <LineGraph Title="@Text.Turns" 
                Min="(_selectedSession.Turns.Min(t => t.Time!.Value.TotalMinutes) * 0.9d)" 
                Max="(_selectedSession.Turns.Min(t => t.Time!.Value.TotalMinutes) * 1.1d)" 
                Points="TurnsToLineGraphPoints(_selectedSession.Turns)"></LineGraph>
        </section>
    }
</div>

@code {
    private Settings _settings = new Settings();
    private List<Session> _sessions = [];
    private Session? _activeSession;
    private Session? _selectedSession;

    private string _timeFormat => @"mm\:ss";

    protected override void OnInitialized()
    {

    }

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();

        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;

        _sessions = await ContentService.LoadSessions();
        _selectedSession = _activeSession = _sessions.FirstOrDefault(x => x.EndTime is null);
    }

    public async Task StartSession()
    {
        if (_activeSession is not null)
            return;
        _activeSession = new Session();
        await ContentService.SaveSession(_activeSession);
    }
    public async Task EndSession()
    {
        if (_activeSession is null)
            return;
        _activeSession.EndTime = DateTime.UtcNow;
        await ContentService.SaveSession(_activeSession);
        _activeSession = null;
    }

    private static IEnumerable<LineGraphPoint<double>> TurnsToLineGraphPoints(List<Turn> turns)
        => turns.Where(t => t.Time.HasValue).Select(t => new LineGraphPoint<double>() { Label = $"{Text.Turn} {turns.IndexOf(t) + 1}", Value = t.Time!.Value.TotalMinutes });
}