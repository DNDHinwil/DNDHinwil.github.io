@page "/characters"
@inject IContentService ContentService

<PageTitle>@Constants.SiteName - @Text.Characters</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <section>
        <h2>@Text.Characters</h2>
    </section>
    <section class="character-select">
        @foreach (var character in _characters)
        {
            <div class="character @(character.Id == _settings.ActiveCharacter ? "active" : "")">
                <button @onclick="async x => await SelectCharacterForEditing(character)" popovertargetaction="show" popovertarget="delete-character" style="font-size:0.5rem;">X</button>
                <label style="font-size:1.25rem;padding-top:0.25rem;">@character.Name</label>
                <label style="text-align:right;padding-top:0.5rem;">@Text.Level_Short</label>
                <label style="text-align:left;padding-top:0.5rem;">@character.Level</label>
                <button @onclick="async x => await SelectCharacterForEditing(character)" command="show-modal" commandfor="edit-character">⛭</button>
                <button @onclick="async x => await ChangeActiveCharacter(character)">@Text.Activate</button>
            </div>
        }
    </section>
    <section class="create-new">
        <button @onclick="async x => await CreateCharacter()" style="width:100%;">@Text.CreateCharacter</button>
    </section>

    @if (_characterToEdit is not null)
    {
        <dialog id="edit-character" class="edit-character">
            <h3>@Text.Effect</h3>
            <InputWithLabel Label="@Text.Name">
                <InputText @bind-Value="_characterToEdit.Name"></InputText>
            </InputWithLabel>
            <button command="close" commandfor="edit-character">@Text.Cancel</button>
            <button @onclick="async x => await SaveEditingCharacter()" command="close" commandfor="edit-character" style="float:right;">@Text.OK</button>
        </dialog>
    }
    <dialog id="delete-character" popover>
        <label>@Text.AreYouSure</label>
        <button popovertarget="delete-character" popovertargetaction="hide">@Text.Cancel</button>
        <button popovertarget="delete-character" popovertargetaction="hide" @onclick="async x => await DeleteCharacter(_characterToEdit)">@Text.Confirm</button>
    </dialog>
</div>

@code {
    private List<Character> _characters = [];
    private Character _activeCharacter = new Character();
    private Settings _settings = new Settings();

    private Character? _characterToEdit;

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        _characters = await ContentService.LoadPlayer();
        _activeCharacter = _characters.FirstOrDefault(c => c.Id == _settings.ActiveCharacter) ?? new Character();
    }

    private async Task ChangeActiveCharacter(Character character)
    {
        _activeCharacter = character;
        _settings.ActiveCharacter = _activeCharacter.Id;
        await ContentService.SaveSettings(_settings);
    }

    private async Task SelectCharacterForEditing(Character character)
        => _characterToEdit = character;

    private async Task SaveEditingCharacter()
    {
        if (_characterToEdit is null)
            return;
        await ContentService.SaveCharacter(_characterToEdit);
        _characterToEdit = null;
    }

    private async Task CreateCharacter()
    {
        _activeCharacter = new Character();
        _characters.Add(_activeCharacter);
        await ContentService.SavePlayer(_characters);
        _settings.ActiveCharacter = _activeCharacter.Id;
        await ContentService.SaveSettings(_settings);
    }

    private async Task DeleteCharacter(Character? character)
    {
        if (character is null)
        {
            return;
        }
        else if (_characters.Count == 1)
        {
            await ContentService.MakeAlert("Can't delete your last character.");
            return;
        }
        else if (character.Id == _activeCharacter.Id)
        {
            await ContentService.MakeAlert("Can't delete your active character.");
            return;
        }
        _characters.Remove(character);
        await ContentService.SavePlayer(_characters);
    }
}
