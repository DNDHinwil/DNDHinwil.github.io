@page "/stats"
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - @Text.Stats</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header class="title">
        <h2>@Text.Stats</h2>
    </header>
    <section class="general">
        <h3>@($"{Text.ActiveCharacter}: {_activeCharacter.Name}")</h3>
        <InputWithLabel Label="@Text.Experience">
            <InputNumber @bind-Value="_activeCharacter.ExperiencePoints"></InputNumber>
        </InputWithLabel>
        <InputWithLabel Label="@Text.LevelModifier">
            <InputNumber @bind-Value="_activeCharacter.LevelModifier"></InputNumber>
        </InputWithLabel>
        <InputWithLabel Label="@Text.MaxHP">
            <InputNumber @bind-Value="_activeCharacter.MaxHealth"></InputNumber>
        </InputWithLabel>
        <InputWithLabel Label="@Text.MaxMP">
            <InputNumber @bind-Value="_activeCharacter.MaxMana"></InputNumber>
        </InputWithLabel>
        
        <button @onclick="async x => await SavePlayer()" style="width:100%;">@Text.Save</button>
    </section>
    <section class="stats">
        <div></div>
        <div>@Text.Name</div>
        <div >@Text.Score</div>
        <div>@Text.Modifier</div>
        <div></div>
        @foreach (var modifier in _activeCharacter.CalculateModifiers(_settings.ScoreModifiers))
        {
            <div class="stat">
                <button class="left-button" @onclick="x => SelectStatForEditing(modifier.Stat)" command="show-modal" commandfor="delete-stat">@Constants.Symbol_Delete</button>
                <div>@modifier.Stat.Name</div>
                <div>@modifier.Stat.Score</div>
                <div>@modifier.TotalValue</div>
                <button class="right-button" @onclick="x => SelectStatForEditing(modifier.Stat)" command="show-modal" commandfor="edit-stat">@Constants.Symbol_Edit</button>
            </div>
        }
        <button @onclick="x => AddNewStat()" command="show-modal" commandfor="edit-stat" style="grid-column:span 5;">@Text.NewStat</button>
    </section>
    @if (_editStat is not null)
    {
        <dialog id="edit-stat">
            <h4>@Text.Stat</h4>
            <InputWithLabel Label="@Text.Name">
                <InputText @bind-Value="_editStat.Name"></InputText>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Short">
                <InputText @bind-Value="_editStat.Short"></InputText>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Score">
                <InputNumber @bind-Value="_editStat.Score"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Boost">
                <InputNumber @bind-Value="_editStat.Boost"></InputNumber>
            </InputWithLabel>
            <button @onclick="x => FinishEditingStat(false)" command="close" commandfor="edit-stat">@Text.Cancel</button>
            <button @onclick="x => FinishEditingStat(true)" command="close" commandfor="edit-stat" style="float:right;">@Text.Save</button>
        </dialog>
    }
    <dialog id="delete-stat">
        <label>@Text.AreYouSure</label>
        <button @onclick="x => FinishEditingStat(false)" command="close" commandfor="delete-stat">@Text.Cancel</button>
        <button @onclick="async x => await DeleteStat(_editStat)" command="close" commandfor="delete-stat">@Text.Confirm</button>
    </dialog>
</div>

@code {
    private Settings _settings = new Settings();
    private Character _activeCharacter = new Character();

    private Stat? _editStat;

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        _activeCharacter = await ContentService.LoadCharacter(_settings.ActiveCharacter);
        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;
    }

    public void AddNewStat()
    {
        var stat = new Stat();
        stat.Name = $"{Text.Stat} {_activeCharacter.ActiveEffects.Count}";
        SelectStatForEditing(stat);
    }
    public void SelectStatForEditing(Stat stat)
        => _editStat = stat;

    public async Task FinishEditingStat(bool save)
    {
        if (_editStat is null)
            return;
        if (!save)
        {
            _editStat = null;
            return;
        }
        if (!_activeCharacter.Stats.Any(e => e.Id == _editStat.Id))
            _activeCharacter.Stats.Add(_editStat);

        await ContentService.SaveCharacter(_activeCharacter);
        _editStat = null;
    }

    public async Task DeleteStat(Stat? stat)
    {
        if (stat is null)
            return;
        _activeCharacter.Stats.Remove(stat);
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task SavePlayer()
        => await ContentService.SaveCharacter(_activeCharacter);
}
