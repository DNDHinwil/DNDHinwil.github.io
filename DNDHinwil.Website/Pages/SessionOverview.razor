@page "/sessions"
@using System.Globalization
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - @Text.Sessions</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header class="title">
        <h2>@Text.Sessions</h2>
    </header>
    <section class="active-session">
        <h3>@Text.Session</h3>
        @if (_activeSession is null)
        {
            <button @onclick="async x => await StartSession()" style="width:100%;">@Text.StartSession</button>
        }
        else
        {
            <div style="width:100%;text-align:center;">@Text.ActiveSession @_activeSession.StartTime.ToString("dd/MM hh:mm")</div>
        }
    </section>
    @if (_selectedSession is not null && _selectedSession.Turns.Count > 2)
    {
        <section class="turns">
            <h3>@Text.Turns</h3>
            <LineGraph Max="(_selectedSession.Turns.Max(t => t.Time!.Value.TotalMinutes) * 1.1d)"
                       Points="TurnsToLineGraphPoints(_selectedSession.Turns)"
                       Marked="_settings.PreferredTurnLength.TotalMinutes"
                       Height="200"></LineGraph>
        </section>
    }
    @if (_sessions.Count > 1)
    {
        <section class="past-sessions">
            <h3>@Text.PastSessions</h3>
            <InputSelect @bind-Value="_selectedSessionId" @onselect="async x => await SelectSession(_selectedSessionId)">
                @foreach (var session in _sessions)
                {
                    <option value="@session.Id">@session.StartTime.ToShortDateString()</option>
                }
            </InputSelect>
        </section>
    }
</div>

@code {
    private Settings _settings = new Settings();

    private List<Session> _sessions = [];
    private Session? _activeSession;

    private Session? _selectedSession;
    private string? _selectedSessionId;

    private string _timeFormat => @"mm\:ss";

    protected override void OnInitialized()
    {

    }

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();

        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;

        _sessions = await ContentService.LoadSessions();
        _selectedSession = _activeSession = _sessions.FirstOrDefault(x => x.EndTime is null);
    }

    public async Task SelectSession(string? sessionId)
    {
        _selectedSession = _sessions.FirstOrDefault(s => s.Id == sessionId);
        StateHasChanged();
    }

    public async Task StartSession()
    {
        if (_activeSession is not null)
            return;
        _selectedSession = _activeSession = new Session();
        await ContentService.SaveSession(_activeSession);
    }
    public async Task EndSession()
    {
        if (_activeSession is null)
            return;
        _activeSession.EndTime = DateTime.UtcNow;
        await ContentService.SaveSession(_activeSession);
        _activeSession = null;
    }

    private static IEnumerable<LineGraphPoint<double>> TurnsToLineGraphPoints(List<Turn> turns)
    {
        var turnText = turns.Count < 5 ? Text.Turn : turns.Count < 9 ? Text.TurnShort : null;
        return turns.Where(t => t.Time.HasValue).Select(t => new LineGraphPoint<double>() { Label = turnText is not null ? $"{turnText} {turns.IndexOf(t) + 1}" : null, Value = t.Time!.Value.TotalMinutes });
    }
}