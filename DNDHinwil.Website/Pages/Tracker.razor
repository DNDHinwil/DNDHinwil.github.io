@page "/"
@using System.Globalization
@using DNDHinwil.Website.Extensions
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - Tracker</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header>
        <h2>Tracker</h2>
        <TimerOutput Model="_timer"></TimerOutput>
    </header>

    <section class="player">
        <div class="stats">
            <StatDisplay Modifiers="@_activeCharacter.CalculateModifiers(_settings.ScoreModifiers)"></StatDisplay>
        </div>
        <div class="portrait">
            <div class="image-and-turn-buttons" style="grid-column:span 2;">
                <div class="profile-image">
                    <img src="@_activeCharacter.ImageUrl" />
                </div>
                <button @onclick="async x => await EndTurn()" class="turn-button">@Text.EndTurn</button>
                @if (_timer is not null && !_timer.TimerRunning)
                {
                    <button class="turn-button" @onclick="async x => await StartTurn()">@Text.StartTurn</button>
                }
                else if (_timer is not null && _timer.Paused)
                {
                    <button class="turn-button" @onclick="x => _timer.UnpauseTimer()">@Text.Unpause</button>
                }
                else if (_timer is not null)
                {
                    <button class="turn-button" @onclick="x => _timer.PauseTimer()">@Text.Pause</button>
                }
            </div>

            <div class="name" style="grid-column:span 2;">
                <h3>@_activeCharacter.Name</h3>
                <div class="level" style="text-align:right;">@Text.Level_Short</div>
                <div class="level" style="text-align:left;">@_activeCharacter.GetLevel(_settings.LevelThresholds)</div>
            </div>

            <div style="margin-bottom:0.125rem;grid-column:span 2;">
                <PercentageBar Max="_experienceToNextLevel.Required"
                               Current="_experienceToNextLevel.Current"
                               Color="#f4d855"
                               Height="5"></PercentageBar>
            </div>

            <button class="left-button rest-button" popovertargetaction="show" popovertarget="take-rest">@Constants.Symbol_Rest</button>

            <div class="health">
                <div>@Text.HealthShort</div>
                <div style="text-align:right;">@_activeCharacter.Health</div>
                <span>/</span>
                <div style="text-align:right;margin-right:0.125rem;">@_activeCharacter.MaxHealth</div>
                <PercentageBar Max="@_activeCharacter.MaxHealth" Current="@_activeCharacter.Health" Color="red"></PercentageBar>
            </div>

            <div class="mana">
                <div>@Text.ManaShort</div>
                <div style="text-align:right;">@_activeCharacter.Mana</div>
                <span>/</span>
                <div style="text-align:right;margin-right:0.125rem;">@_activeCharacter.MaxMana</div>
                <PercentageBar Max="@_activeCharacter.MaxMana" Current="@_activeCharacter.Mana" Color="blue"></PercentageBar>
            </div>
        </div>
        <div class="quick-actions">
            <div>@Text.TakeHealing</div>
            <button class="action-button" popovertarget="quick-effect" @onclick="x => StartQuickEffect(false)">@Constants.Symbol_Heal</button>
            <div>@Text.TakeDamage</div>
            <button class="action-button" popovertarget="quick-effect" @onclick="x => StartQuickEffect(true)">@Constants.Symbol_Damage</button>
        </div>
    </section>

    
    <CollapsibleSection Title="@Text.ActiveEffects">
        @if (_activeCharacter.ActiveEffects.Any())
        {
            @foreach (var effect in _activeCharacter.ActiveEffects)
            {
                <div class="active-effect">
                    <button class="left-button" @onclick="x => RemoveEffect(effect)">@Constants.Symbol_Delete</button>
                    <div>@effect.Name</div>
                    @switch (effect.Outcome)
                    {
                        case EffectOutcome.DealsDamage:
                            <div>@effect.Strength @Text.Damage</div>
                            break;
                        case EffectOutcome.Heals:
                            <div>@effect.Strength @Text.Heal</div>
                            break;
                        case EffectOutcome.Special:
                            <div></div>
                            break;
                        default:
                            break;
                    }
                    @switch (effect.Duration)
                    {
                        case EffectDuration.Turns:
                            <div style="text-align:center;">@effect.Turns @Text.Turns</div>
                            break;
                        case EffectDuration.UntilHealed:
                            <div style="text-align:center;">@Constants.Symbol_UntilHealed</div>
                            break;
                        case EffectDuration.UntilRemoved:
                            <div style="text-align:center;">@Constants.Symbol_UntilRemoved</div>
                            break;
                    }
                    <button class="right-button" @onclick="x => StartEditingEffect(effect)" command="show-modal" commandfor="edit-active-effect">@Constants.Symbol_Edit</button>
                </div>
            }
        }
        else
        {
            <div>@Text.NoTriggeredEffects</div>
        }
        <button @onclick="x => AddNewEffect()" style="width:100%;margin-top:0.5rem;height:32px;" command="show-modal" commandfor="edit-active-effect">@Text.NewTriggeredEffect</button>
    </CollapsibleSection>

    <CollapsibleSection Title="@Text.Spellbook">
        @if (_activeCharacter.Spellbook.Any())
        {
            var modifiers = _activeCharacter.CalculateModifiers(_settings.ScoreModifiers);
            @foreach (var spell in _activeCharacter.Spellbook)
            {
                <div class="spell">
                    <SpellOrAbility Model="spell" Modifiers="modifiers"></SpellOrAbility>
                    @if (spell.CanBeUsedOnSelf)
                    {
                        <button @onclick="async x => await UseSpell(spell, true)">@Constants.Symbol_UseOnSelf</button>
                    }
                    else
                    {
                        <div></div>
                    }
                    <button @onclick="async x => await UseSpell(spell, false)">@Constants.Symbol_Use</button>
                </div>
            }
        }
        else
        {
            <div>@Text.NoSpellsInSpellbook</div>
        }
    </CollapsibleSection>

    <CollapsibleSection Title="@Text.Inventory">
        @if (_activeCharacter.Inventory.Any())
        {
            @foreach (var item in _activeCharacter.Inventory)
            {
                <div class="equipment-item">
                    <EquipmentItem Model="item"></EquipmentItem>
                    @if (item.Usable)
                    {
                        @if (item.CanBeUsedOnSelf)
                        {
                            <button @onclick="async x => await UseEquipment(item, true)">@Constants.Symbol_UseOnSelf</button>
                        }
                        else
                        {
                            <div></div>
                        }
                        <button @onclick="async x => await UseEquipment(item, false)">@Constants.Symbol_Use</button>
                    }
                    else
                    {
                        <div></div>
                        <div></div>
                    }
                </div>
            }
        }
        else
        {
            <div>@Text.NoEquipmentInInventory</div>
        }
    </CollapsibleSection>

    <CollapsibleSection Title="@Text.Gear">
        @if (_activeCharacter.Gear.Where(g => g.IsEquipped).Any())
        {
            @foreach (var item in _activeCharacter.Gear.Where(g => g.IsEquipped))
            {
                <div class="equipment-item">
                    <GearItem Model="item"></GearItem>
                    @if (item.Usable)
                    {
                        
                    }
                    else
                    {
                        <div></div>
                        <div></div>
                    }
                </div>
            }
        }
        else
        {
            <div>@Text.NoGearEquipped</div>
        }
    </CollapsibleSection>

    @if (_editActiveEffect is not null)
    {
        <dialog id="edit-active-effect" class="edit-active-effect">
            <h3>@Text.Effect</h3>
            <InputWithLabel Label="@Text.Name">
                <InputText @bind-Value="_editActiveEffect.Name"></InputText>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Strength">
                <InputNumber @bind-Value="_editActiveEffect.Strength"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Outcome">
                <InputSelect @bind-value="_editActiveEffect.Outcome">
                    <option value="@EffectOutcome.DealsDamage">@Text.Damage</option>
                    <option value="@EffectOutcome.Heals">@Text.Heal</option>
                    <option value="@EffectOutcome.Special">@Text.Other</option>
                </InputSelect>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Duration">
                <InputSelect @bind-value="_editActiveEffect.Duration">
                    <option value="@EffectDuration.Turns">@Text.Turns</option>
                    <option value="@EffectDuration.UntilHealed">@Text.UntilHealed</option>
                    <option value="@EffectDuration.UntilRemoved">@Text.UntilRemoved</option>
                </InputSelect>
            </InputWithLabel>
            @if (_editActiveEffect.Duration is EffectDuration.Turns)
            {
                <InputWithLabel Label="@Text.Turns">
                    <InputNumber @bind-Value="_editActiveEffect.Turns"></InputNumber>
                </InputWithLabel>
            }
            @if (_editActiveEffect.Outcome is EffectOutcome.DealsDamage or EffectOutcome.Heals)
            {
                <InputWithLabel Label="@Text.Target">
                    <InputSelect @bind-value="_editActiveEffect.Target">
                        <option value="@EffectTarget.Health">@Text.Health</option>
                        <option value="@EffectTarget.Mana">@Text.Mana</option>
                        <option value="@EffectTarget.HealthAndMana">@Text.HealthShort & @Text.ManaShort</option>
                    </InputSelect>
                </InputWithLabel>
            }
            <InputWithLabel Label="@Text.TriggersAtEndOfTurn">
                <InputCheckbox @bind-Value="_editActiveEffect.TriggersAtEnd"></InputCheckbox>
            </InputWithLabel>
            <button @onclick="x => FinishEditingEffect(false)" command="close" commandfor="edit-active-effect">@Text.Cancel</button>
            <button @onclick="x => FinishEditingEffect(true)" command="close" commandfor="edit-active-effect" style="float:right;">@Text.Save</button>
        </dialog>
    }

    @if (_quickEffect is not null)
    {
        <dialog id="quick-effect" popover>
            <h4>@(_quickEffect.Outcome == EffectOutcome.DealsDamage ? Text.Damage : Text.Heal)</h4>
            <InputWithLabel Label="@(_quickEffect.Outcome == EffectOutcome.DealsDamage ? Text.DamageFor : Text.HealFor)">
                <InputNumber @bind-Value="_quickEffect.Strength"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="@Text.To">
                <InputSelect @bind-value="_quickEffect.Target">
                    <option value="@EffectTarget.Health">@Text.Health</option>
                    <option value="@EffectTarget.Mana">@Text.Mana</option>
                    <option value="@EffectTarget.HealthAndMana">@Text.HealthShort & @Text.ManaShort</option>
                </InputSelect>
            </InputWithLabel>
            <button popovertarget="quick-effect" popovertargetaction="hide">@Text.Cancel</button>
            <button style="float:right;" popovertarget="quick-effect" popovertargetaction="hide" @onclick="async x => await ExecuteQuickEffect()">@Text.OK</button>
        </dialog>
    }

    <dialog id="take-rest" popover>
        <h4>@Text.Rest</h4>
        <button popovertarget="take-rest" popovertargetaction="hide">@Text.Cancel</button>
        <button style="float:right;" popovertarget="take-rest" popovertargetaction="hide" @onclick="async x => await Rest()">@Text.OK</button>
    </dialog>
</div>

@code {
    private Settings _settings = new Settings();
    private Character _activeCharacter = new Character();
    private (int Current, int Required) _experienceToNextLevel = (0, 300);

    private Session? _activeSession;
    private UpCountingTimer? _timer;
    private Turn? _activeTurn;

    private EffectOverTime? _editActiveEffect;
    private Effect? _quickEffect;

    protected override void OnInitialized()
    {
        _timer = new UpCountingTimer(UpdateUi);
    }

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        _activeCharacter = await ContentService.LoadCharacter(_settings.ActiveCharacter);
        if (string.IsNullOrWhiteSpace(_settings.ActiveCharacter))
        {
            _settings.ActiveCharacter = _activeCharacter.Id;
            await ContentService.SaveSettings(_settings);
        }
        _experienceToNextLevel = _settings.LevelThresholds.ExperienceToNextLevel(_activeCharacter.ExperiencePoints);

        _timer = new UpCountingTimer(UpdateUi);
        var sessions = await ContentService.LoadSessions();
        _activeSession = sessions.FirstOrDefault(s => s.EndTime is null) ?? new Session();

        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;
    }

    private void UpdateUi(object? state)
    {
        StateHasChanged();
    }

    private async Task StartTurn()
    {
        if (_activeSession is null)
        {  
            _activeSession = new();
            await ContentService.SaveSession(_activeSession);
        }
        _timer ??= new UpCountingTimer(UpdateUi);

        _activeTurn = new Turn() { Character = _activeCharacter };
        _activeSession.Turns.Add(_activeTurn);
        await ContentService.SaveSession(_activeSession);

        await ExecuteActiveEffects(false);
        _timer.StartTimer();

        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task EndTurn()
    {
        if (_activeSession is null || _timer is null || _activeTurn is null)
            return;

        await ExecuteActiveEffects(true);
        _timer!.StopTimer();

        _activeTurn.Time = _timer.Time;
        _activeTurn = null;
        await ContentService.SaveSession(_activeSession);

        _activeCharacter.ActiveEffects.RemoveAll(x => x.Duration is EffectDuration.Turns && x.Turns < 1);
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task UseSpell(Spell spell, bool useOnYourself)
    {
        if (spell.ManaCost > _activeCharacter.Mana)
        {
            await ContentService.MakeAlert(Text.NotEnoughMana);
            return;
        }
        await _activeCharacter.UseSpell(spell, useOnYourself);
        await ContentService.SaveCharacter(_activeCharacter);

        _activeSession ??= new Session();
        _activeSession.SpellCasts.Add(new() { CharacterId = _activeCharacter.Id, SpellId = spell.Id });
        await ContentService.SaveSession(_activeSession);
    }

    private async Task UseEquipment(Equipment equipment, bool useOnYourself)
    {
        await _activeCharacter.UseEquipmentItem(equipment, useOnYourself);
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task ExecuteActiveEffects(bool isEndOfTurn)
    {
        await _activeCharacter.ExecuteActiveEffects(isEndOfTurn);
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task Rest()
    {
        await _activeCharacter.Rest();
        await ContentService.SaveCharacter(_activeCharacter);
    }

    #region Quick Effect
    private void StartQuickEffect(bool isDamaging)
        => _quickEffect = new Effect()
            {
                Outcome = isDamaging ? EffectOutcome.DealsDamage : EffectOutcome.Heals
            };

    private async Task ExecuteQuickEffect()
    {
        if (_quickEffect is null)
            return;
        await _activeCharacter.UseQuickEffect(_quickEffect);
        _quickEffect = null;
        await ContentService.SaveCharacter(_activeCharacter);
    }
    #endregion

    #region Active Effects
    private void AddNewEffect()
    {
        var effect = new EffectOverTime();
        effect.Name = $"{Text.Effect} {_activeCharacter.ActiveEffects.Count}";
        StartEditingEffect(effect);
    }

    private void StartEditingEffect(EffectOverTime effect)
        => _editActiveEffect = effect;

    private async Task FinishEditingEffect(bool save)
    {
        if (_editActiveEffect is null)
            return;
        if (!save || _activeCharacter.ActiveEffects.Any(e => e.Id == _editActiveEffect.Id))
        {
            _editActiveEffect = null;
            return;
        }
        _activeCharacter.ActiveEffects.Add(_editActiveEffect);

        _editActiveEffect = null;
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task RemoveEffect(EffectOverTime effect)
    {
        _activeCharacter.ActiveEffects.Remove(effect);
        await ContentService.SaveCharacter(_activeCharacter);
    }
    #endregion
}