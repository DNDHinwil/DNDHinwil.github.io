@page "/"
@using System.Globalization
@using DNDHinwil.Website.Extensions
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - Tracker</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header class="title">
        <h2>Tracker</h2>
        <TimerOutput Model="_timer"></TimerOutput>
    </header>

    <section class="timer-controls">
        <button @onclick="async x => await EndTurn()" class="timer-button">@Text.EndTurn</button>
        @if (_timer is not null && !_timer.TimerRunning)
        {
            <button class="timer-button" @onclick="async x => await StartTurn()">@Text.StartTurn</button>
        }
        else if (_timer is not null && _timer.Paused)
        {
            <button class="timer-button" @onclick="x => _timer.UnpauseTimer()">@Text.Unpause</button>
        }
        else if (_timer is not null)
        {
            <button class="timer-button" @onclick="x => _timer.PauseTimer()">@Text.Pause</button>
        }
    </section>

    <section>
        <StatDisplay Stats="_activeCharacter.Stats" AbilityScores="_settings.ScoreModifiers"></StatDisplay>
    </section>

    <section class="player">
        <div class="portrait">
            <div class="profile-image" style="grid-column:span 3;">
                <img src="@_activeCharacter.ImageUrl" />
            </div>
            <h3>@_activeCharacter.Name</h3>
            <div class="level" style="text-align:right;">@Text.Level_Short</div>
            <div class="level" style="text-align:left;">@_activeCharacter.GetLevel(_settings.LevelThresholds)</div>
            <div style="grid-column:span 3;margin-bottom:0.125rem;">
                <PercentageBar Max="_experienceToNextLevel.Required"
                               Current="_experienceToNextLevel.Current"
                               Color="#f4d855"
                               Height="5"></PercentageBar>
            </div>
            <div class="health" style="grid-column:span 3;">
                <div>@Text.HealthShort</div>
                <div style="text-align:right;">@_activeCharacter.Health</div>
                <span>/</span>
                <div style="text-align:left;">@_activeCharacter.MaxHealth</div>
                <PercentageBar Max="@_activeCharacter.MaxHealth" Current="@_activeCharacter.Health" Color="red"></PercentageBar>
            </div>
            <div class="mana" style="grid-column:span 3;">
                <div>@Text.ManaShort</div>
                <div style="text-align:right;">@_activeCharacter.Mana</div>
                <span>/</span>
                <div style="text-align:left;">@_activeCharacter.MaxMana</div>
                <PercentageBar Max="@_activeCharacter.MaxMana" Current="@_activeCharacter.Mana" Color="blue"></PercentageBar>
            </div>
        </div>
        <div class="turn-buttons">
            <button popovertargetaction="show" popovertarget="take-rest">@Text.Rest</button>
            <button popovertargetaction="show" popovertarget="take-heal">@Text.TakeHealing</button>
            <button popovertargetaction="show" popovertarget="take-damage">@Text.TakeDamage</button>
        </div>
    </section>

    <section class="spellbook">
        <h3 style="grid-row:span 2;">@Text.Spellbook</h3>
        @if (_activeCharacter.Spellbook.Any())
        {
            @foreach (var spell in _activeCharacter.Spellbook)
            {
                <CastableSpell Model="spell" CharacterStats="_activeCharacter.Stats" AbilityScoreTable="_settings.ScoreModifiers"></CastableSpell>
                <button>@Text.Cast</button>
            }
        }
        else
        {
            <div>@Text.NoSpellsInSpellbook</div>
        }
    </section>

    <section class="active-effects">
        <h3>@Text.ActiveEffects</h3>
        @if (_activeCharacter.ActiveEffects.Any())
        {
            @foreach (var effect in _activeCharacter.ActiveEffects)
            {
                <div class="active-effect">
                    <button class="active-effect-button" @onclick="x => RemoveEffect(effect)">-</button>
                    <div>@effect.Name</div>
                    @switch (effect.Outcome)
                    {
                        case IEffect.EffectOutcome.DealsDamage:
                            <div>@effect.Strength @Text.Damage</div>
                            break;
                        case IEffect.EffectOutcome.Heals:
                            <div>@effect.Strength @Text.Heal</div>
                            break;
                        case IEffect.EffectOutcome.Special:
                            <div></div>
                            break;
                        default:
                            break;
                    }
                    @switch (effect.Duration)
                    {
                        case ActiveEffect.EffectDuration.Turns:
                            <div style="text-align:center;">@effect.Turns @Text.Turns</div>
                            break;
                        case ActiveEffect.EffectDuration.UntilHealed:
                            <div style="text-align:center;">🩸</div>
                            break;
                        case ActiveEffect.EffectDuration.UntilRemoved:
                            <div style="text-align:center;">∞</div>
                            break;
                    }
                    <button @onclick="x => StartEditingEffect(effect)" command="show-modal" commandfor="edit-active-effect">⛭</button>
                </div>
            }
        }
        else
        {
            <div>@Text.NoTriggeredEffects</div>
        }
        <button @onclick="x => AddNewEffect()" command="show-modal" commandfor="edit-active-effect">@Text.NewTriggeredEffect</button>

    </section>

    @if (_editEffect is not null)
    {
        <dialog id="edit-active-effect" class="edit-active-effect">
            <h3>@Text.Effect</h3>
            <InputWithLabel Label="@Text.Name">
                <InputText @bind-Value="_editEffect.Name"></InputText>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Strength">
                <InputNumber @bind-Value="_editEffect.Strength"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Outcome">
                <InputSelect @bind-value="_editEffect.Outcome">
                    <option value="@IEffect.EffectOutcome.DealsDamage">@Text.Damage</option>
                    <option value="@IEffect.EffectOutcome.Heals">@Text.Heal</option>
                    <option value="@IEffect.EffectOutcome.Special">@Text.Other</option>
                </InputSelect>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Duration">
                <InputSelect @bind-value="_editEffect.Duration">
                    <option value="@ActiveEffect.EffectDuration.Turns">@Text.Turns</option>
                    <option value="@ActiveEffect.EffectDuration.UntilHealed">@Text.UntilHealed</option>
                    <option value="@ActiveEffect.EffectDuration.UntilRemoved">@Text.UntilRemoved</option>
                </InputSelect>
            </InputWithLabel>
            @if (_editEffect.Duration is ActiveEffect.EffectDuration.Turns)
            {
                <InputWithLabel Label="@Text.Turns">
                    <InputNumber @bind-Value="_editEffect.Turns"></InputNumber>
                </InputWithLabel>
            }
            @if (_editEffect.Outcome is IEffect.EffectOutcome.DealsDamage or IEffect.EffectOutcome.Heals)
            {
                <InputWithLabel Label="@Text.Target">
                    <InputSelect @bind-value="_editEffect.Target">
                        <option value="@IEffect.EffectTarget.Health">@Text.Health</option>
                        <option value="@IEffect.EffectTarget.Mana">@Text.Mana</option>
                        <option value="@IEffect.EffectTarget.Special">@Text.Special</option>
                    </InputSelect>
                </InputWithLabel>
            }
            <InputWithLabel Label="@Text.TriggersAtEndOfTurn">
                <InputCheckbox @bind-Value="_editEffect.TriggersAtEnd"></InputCheckbox>
            </InputWithLabel>
            <button @onclick="x => FinishEditingEffect(false)" command="close" commandfor="edit-active-effect">@Text.Cancel</button>
            <button @onclick="x => FinishEditingEffect(true)" command="close" commandfor="edit-active-effect" style="float:right;">@Text.Save</button>
        </dialog>
    }

    <dialog id="take-rest" popover>
        <h4>@Text.Rest</h4>
        <button popovertarget="take-rest" popovertargetaction="hide">@Text.Cancel</button>
        <button popovertarget="take-rest" popovertargetaction="hide" @onclick="async x => await Rest()">@Text.OK</button>
    </dialog>

    <dialog id="take-heal" popover>
        <h4>@Text.Heal</h4>
        <InputWithLabel Label="@Text.TakeHealing">
            <InputNumber @bind-Value="_quickEffect.Strength"></InputNumber>
        </InputWithLabel>
        <InputWithLabel Label="@Text.Target">
            <InputSelect @bind-value="_quickEffect.Target">
                <option value="@IEffect.EffectTarget.Health">@Text.Health</option>
                <option value="@IEffect.EffectTarget.Mana">@Text.Mana</option>
                <option value="@IEffect.EffectTarget.Special">@Text.None</option>
                <option value="@IEffect.EffectTarget.HealthAndMana">@Text.HealthShort & @Text.ManaShort</option>
            </InputSelect>
        </InputWithLabel>
        <button popovertarget="take-heal" popovertargetaction="hide">@Text.Cancel</button>
        <button popovertarget="take-heal" popovertargetaction="hide" @onclick="async x => await HealUp(_quickEffect)">@Text.OK</button>
    </dialog>

    <dialog id="take-damage" popover>
        <h4>@Text.Damage</h4>
        <InputWithLabel Label="@Text.TakeDamage">
            <InputNumber @bind-Value="_quickEffect.Strength"></InputNumber>
        </InputWithLabel>
        <InputWithLabel Label="@Text.Target">
            <InputSelect @bind-value="_quickEffect.Target">
                <option value="@IEffect.EffectTarget.Health">@Text.Health</option>
                <option value="@IEffect.EffectTarget.Mana">@Text.Mana</option>
                <option value="@IEffect.EffectTarget.HealthAndMana">@Text.HealthShort & @Text.ManaShort</option>
                <option value="@IEffect.EffectTarget.Special">@Text.None</option>
            </InputSelect>
        </InputWithLabel>
        <button popovertarget="take-damage" popovertargetaction="hide">@Text.Cancel</button>
        <button popovertarget="take-damage" popovertargetaction="hide" @onclick="async x => await TakeDamage(_quickEffect)">@Text.OK</button>
    </dialog>
</div>

@code {
    private Settings _settings = new Settings();
    private Session? _activeSession;
    private Character _activeCharacter = new Character();
    private ActiveEffect? _editEffect;
    private UpCountingTimer? _timer;
    private Turn? _activeTurn;
    private (int Current, int Required) _experienceToNextLevel = (0, 300);

    private Effect _quickEffect = new Effect();

    protected override void OnInitialized()
    {
        _timer = new UpCountingTimer(UpdateUi);
    }

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        _activeCharacter = await ContentService.LoadCharacter(_settings.ActiveCharacter);
        if (string.IsNullOrWhiteSpace(_settings.ActiveCharacter))
        {
            _settings.ActiveCharacter = _activeCharacter.Id;
            await ContentService.SaveSettings(_settings);
        }
        _experienceToNextLevel = _settings.LevelThresholds.ExperienceToNextLevel(_activeCharacter.ExperiencePoints);

        _timer = new UpCountingTimer(UpdateUi);
        var sessions = await ContentService.LoadSessions();
        _activeSession = sessions.FirstOrDefault(s => s.EndTime is null);

        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;
    }

    public async Task StartTurn()
    {
        if (_activeSession is null)
        {  
            _activeSession = new();
            await ContentService.SaveSession(_activeSession);
        }
        if (_timer is null)
            _timer = new UpCountingTimer(UpdateUi);

        _activeTurn = new Turn() { Character = _activeCharacter };
        _activeSession.Turns.Add(_activeTurn);
        await ContentService.SaveSession(_activeSession);

        await ExecuteActiveEffects(false);
        _timer.StartTimer();

        await ContentService.SaveCharacter(_activeCharacter);
    }

    public async Task EndTurn()
    {
        if (_activeSession is null || _timer is null || _activeTurn is null)
            return;

        await ExecuteActiveEffects(true);
        _timer!.StopTimer();

        _activeTurn.Time = _timer.Time;
        _activeTurn = null;
        await ContentService.SaveSession(_activeSession);

        await ContentService.SaveCharacter(_activeCharacter);
        _activeCharacter.ActiveEffects.RemoveAll(x => x.Duration is ActiveEffect.EffectDuration.Turns && x.Turns < 1);
    }

    private async Task ExecuteActiveEffects(bool isEndOfTurn)
    {
        if (_activeCharacter.ActiveEffects.Any(a => a.Outcome is IEffect.EffectOutcome.Heals
            && a.Target is IEffect.EffectTarget.Health
            && a.TriggersAtEnd == isEndOfTurn))
            _activeCharacter.ActiveEffects.RemoveAll(x => x.Duration is ActiveEffect.EffectDuration.UntilHealed);

        foreach (var effect in _activeCharacter.ActiveEffects.Where(e => e.TriggersAtEnd == isEndOfTurn))
        {
            switch (effect.Outcome)
            {
                case IEffect.EffectOutcome.DealsDamage:
                    await TakeDamage(effect);
                    break;
                case IEffect.EffectOutcome.Heals:
                    await HealUp(effect);
                    break;
                default:
                    break;
            }

            if (effect.Duration is ActiveEffect.EffectDuration.Turns)
                effect.Turns--;
        }

    }

    public async Task Rest()
    {
        _activeCharacter.ActiveEffects.RemoveAll(x => x.Turns > 0);
        _activeCharacter.Health = _activeCharacter.MaxHealth;
        _activeCharacter.Mana = _activeCharacter.MaxMana;

        await ContentService.SaveCharacter(_activeCharacter);
    }

    public async Task HealUp(IEffect effect)
    {
        _activeCharacter.ActiveEffects.RemoveAll(x => x.Duration is ActiveEffect.EffectDuration.UntilHealed);

        switch (effect.Target)
        {
            case IEffect.EffectTarget.Health:
                _activeCharacter.Health += effect.Strength;
                break;
            case IEffect.EffectTarget.Mana:
                _activeCharacter.Mana += effect.Strength;
                break;
            case IEffect.EffectTarget.HealthAndMana:
                _activeCharacter.Health += effect.Strength;
                _activeCharacter.Mana += effect.Strength;
                break;
            default:
                break;
        }
        await ContentService.SaveCharacter(_activeCharacter);
    }

    public async Task TakeDamage(Effect effect)
    {
        switch (effect.Target)
        {
            case IEffect.EffectTarget.Health:
                _activeCharacter.Health -= Math.Clamp(effect.Strength - _activeCharacter.DamageReduction, 0, effect.Strength);
                break;
            case IEffect.EffectTarget.Mana:
                _activeCharacter.Mana -= effect.Strength;
                break;
            case IEffect.EffectTarget.HealthAndMana:
                _activeCharacter.Health -= Math.Clamp(effect.Strength - _activeCharacter.DamageReduction, 0, effect.Strength);
                _activeCharacter.Mana -= effect.Strength;
                break;
            default:
                break;
        }
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private void UpdateUi(object? state)
    {
        StateHasChanged();
    }

    private void AddNewEffect()
    {
        var effect = new ActiveEffect();
        effect.Name = $"{Text.Effect} {_activeCharacter.ActiveEffects.Count}";
        StartEditingEffect(effect);
    }

    private void StartEditingEffect(ActiveEffect effect)
        => _editEffect = effect;

    private async Task FinishEditingEffect(bool save)
    {
        if (_editEffect is null)
            return;
        if (!save || _activeCharacter.ActiveEffects.Any(e => e.Id == _editEffect.Id))
        {
            _editEffect = null;
            return;
        }
        _activeCharacter.ActiveEffects.Add(_editEffect);

        await ContentService.SaveCharacter(_activeCharacter);
        _editEffect = null;
    }
    private async Task RemoveEffect(ActiveEffect effect)
    {
        _activeCharacter.ActiveEffects.Remove(effect);
        await ContentService.SaveCharacter(_activeCharacter);
    }
}