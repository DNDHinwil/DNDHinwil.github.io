@page "/"
@using System.Globalization
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - Tracker</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header>
        <h2>Tracker</h2>
        <TimerOutput Model="_timer"></TimerOutput>
    </header>

    <section class="player">
        <div class="stats">
            <StatDisplay Modifiers="@_activeCharacter.GetModifiers(_settings.ScoreModifierTable)"></StatDisplay>
        </div>
        <div class="portrait">
            <div class="image-and-turn-buttons" style="grid-column:span 2;">
                <div class="profile-image">
                    <img src="@_activeCharacter.ImageUrl" />
                    <div class="profile-border">
                        <img src="images/profile_border.png" />
                    </div>
                </div>
                <button @onclick="async x => await EndTurn()" class="turn-button">@Text.EndTurn</button>
                @if (_timer is not null && !_timer.IsTimerRunning)
                {
                    <button class="turn-button" @onclick="async x => await StartTurn()">@Text.StartTurn</button>
                }
                else if (_timer is not null && _timer.Paused)
                {
                    <button class="turn-button" @onclick="x => _timer.UnpauseTimer()">@Text.Unpause</button>
                }
                else if (_timer is not null)
                {
                    <button class="turn-button" @onclick="x => _timer.PauseTimer()">@Text.Pause</button>
                }
            </div>

            <div class="name" style="grid-column:span 2;">
                <h3>@_activeCharacter.Name</h3>
                <div class="level" style="text-align:right;">@Text.Level_Short</div>
                <div class="level" style="text-align:left;">@_activeCharacter.GetLevel(_settings.LevelThresholdTable)</div>
            </div>

            <div style="margin-bottom:0.125rem;grid-column:span 2;">
                <PercentageBar Max="_experienceToNextLevel.Required"
                               Current="_experienceToNextLevel.Current"
                               Color="#f4d855"
                               Height="5"></PercentageBar>
            </div>

            <button class="left-button rest-button" popovertargetaction="show" popovertarget="take-rest">@Constants.Symbol_Rest</button>

            <div class="health">
                <div>@Text.HealthShort</div>
                <div style="text-align:right;">@_activeCharacter.Health</div>
                <span>/</span>
                <div style="text-align:right;margin-right:0.125rem;">@_activeCharacter.GetMaxHealth()</div>
                <PercentageBar Max="@_activeCharacter.GetMaxHealth()" Current="@_activeCharacter.Health" Color="red"></PercentageBar>
            </div>

            <div class="mana">
                <div>@Text.ManaShort</div>
                <div style="text-align:right;">@_activeCharacter.Mana</div>
                <span>/</span>
                <div style="text-align:right;margin-right:0.125rem;">@_activeCharacter.GetMaxMana()</div>
                <PercentageBar Max="@_activeCharacter.GetMaxMana()" Current="@_activeCharacter.Mana" Color="blue"></PercentageBar>
            </div>
        </div>
        <div class="misc">
            <div class="money">
                <div style="text-align:center;border-bottom:1px solid var(--color-foreground);">@Text.Money</div>
                @foreach (var money in _activeCharacter.Money)
                {
                    <div class="currency">
                        <button class="left-button" popovertarget="edit-money" @onclick="x => StartEditingMoney(money)">＄</button>
                        <div>@($"{money.Quantity} {money.Item.Name}")</div>
                    </div>
                }
            </div>
            <div class="quick-actions">
                <div>@Text.TakeHealing</div>
                <button class="right-button action-button" popovertarget="quick-effect" @onclick="x => StartQuickEffect(false)">@Constants.Symbol_Heal</button>
                <div>@Text.TakeDamage</div>
                <button class="right-button action-button" popovertarget="quick-effect" @onclick="x => StartQuickEffect(true)">@Constants.Symbol_Damage</button>
            </div>
        </div>
    </section>

    <CollapsibleSection Title="@Text.BuffsAndDebuffs">  
        @if (_activeCharacter.GetArmor() > 0)
        {
            <div>@($"{Text.Armor}: {_activeCharacter.GetArmor()}")</div>
        }
        @if (_activeCharacter.ActiveEffects.Any() || _activeCharacter.GetPassiveEffects().Any())
        {
            @foreach (var effect in _activeCharacter.GetPassiveEffects())
            {
                <div class="passive-effect">
                    <div style="margin-right:0.5rem;text-align:center;">⛨</div>
                    <EffectView Model="effect" Modifiers="_activeCharacter.GetModifiers(_settings.ScoreModifierTable)"></EffectView>
                    <div></div>
                </div>
            }
            <hr />
            @foreach (var effect in _activeCharacter.ActiveEffects)
            {
                <div class="active-effect">
                    @if (effect.EffectType is EffectType.Active)
                    {
                        <button class="left-button" @onclick="x => RemoveActiveEffect(effect)">@Constants.Symbol_Delete</button>
                        <EffectView Model="effect" Modifiers="_activeCharacter.GetModifiers(_settings.ScoreModifierTable)"></EffectView>
                        <div></div>
                        <button class="right-button" @onclick="x => StartEditingActiveEffect(effect)" command="show-modal" commandfor="edit-effect">@Constants.Symbol_Edit</button>
                    }
                    else
                    {
                        <div style="margin-right:0.5rem;text-align:center;">⛨</div>
                        <EffectView Model="effect" Modifiers="_activeCharacter.GetModifiers(_settings.ScoreModifierTable)"></EffectView>
                        <div></div>
                        <div></div>
                    }
                </div>
            }
        }
        else
        {
            <div>@Text.NoActiveEffects</div>
        }
        <button @onclick="x => AddNewActiveEffect()" style="width:100%;margin-top:0.5rem;height:32px;" command="show-modal" commandfor="edit-effect">@Text.NewActiveEffect</button>
    </CollapsibleSection>

    <CollapsibleSection Title="@Text.Spellbook">
        @if (_activeCharacter.Spellbook.Any())
        {
            @foreach (var spell in _activeCharacter.Spellbook)
            {
                <div class="spell">
                    <div class="left-symbol">📜</div>
                    <SpellOrAbility Model="spell.Item" Modifiers="@_activeCharacter.GetModifiers(_settings.ScoreModifierTable)"></SpellOrAbility>
                    @if (spell.Item.CanBeUsedOnSelf)
                    {
                        <button class="right-button" @onclick="async x => await UseSpell(spell.Item, true)">@Constants.Symbol_UseOnSelf</button>
                    }
                    else
                    {
                        <div></div>
                    }
                    <button class="right-button" @onclick="async x => await UseSpell(spell.Item, false)">@Constants.Symbol_Use</button>
                </div>
            }
        }
        else
        {
            <div>@Text.NoSpellsInSpellbook</div>
        }
    </CollapsibleSection>

    <CollapsibleSection Title="@Text.Inventory">
        @if (_activeCharacter.Inventory.Any())
        {
            @foreach (var equipment in _activeCharacter.Inventory)
            {
                <div class="equipment-item">
                    <div class="left-symbol">👜</div>
                    <EquipmentItem Model="equipment.Item" Quantity="equipment.Quantity" Modifiers="@_activeCharacter.GetModifiers(_settings.ScoreModifierTable)"></EquipmentItem>
                    @if (equipment.Item.Usable)
                    {
                        @if (equipment.Item.CanBeUsedOnSelf)
                        {
                            <button class="right-button" @onclick="async x => await UseEquipment(equipment.Item, true)">@Constants.Symbol_UseOnSelf</button>
                        }
                        else
                        {
                            <div></div>
                        }
                        <button class="right-button" @onclick="async x => await UseEquipment(equipment.Item, false)">@Constants.Symbol_Use</button>
                    }
                    else
                    {
                        <div></div>
                        <div></div>
                    }
                </div>
            }
        }
        else
        {
            <div>@Text.NoEquipmentInInventory</div>
        }
    </CollapsibleSection>

    <CollapsibleSection Title="@Text.Gear">
        @if (_activeCharacter.Gear.Any())
        {
            @foreach (var gear in _activeCharacter.Gear)
            {
                <div class="equipment-item">
                    <button class="left-button" @onclick="async x => await ToggleEquip(gear.Item)">@(gear.IsEquipped ? Constants.Symbol_Equipped : Constants.Symbol_Unequipped)</button>
                    <GearItem Model="gear.Item" Modifiers="@_activeCharacter.GetModifiers(_settings.ScoreModifierTable)" IsEquipped="gear.IsEquipped"></GearItem>
                    @if (gear.Item.Usable)
                    {
                        @if (gear.Item.CanBeUsedOnSelf)
                        {
                            <button class="right-button" @onclick="async x => await UseGear(gear.Item, true)">@Constants.Symbol_UseOnSelf</button>
                        }
                        else
                        {
                            <div></div>
                        }
                        <button class="right-button" @onclick="async x => await UseGear(gear.Item, false)">@Constants.Symbol_Use</button>
                    }
                    else
                    {
                        <div></div>
                        <div></div>
                    }
                </div>
            }
        }
        else
        {
            <div>@Text.NoGearEquipped</div>
        }
    </CollapsibleSection>

    @if (_activeCharacter.Spellbook.Sum(s => s.CastCounter) > 0)
    {
        <CollapsibleSection Title="@Text.Spells">
            <div class="spell-counter">
                @foreach (var item in _activeCharacter.Spellbook.Where(s => s.CastCounter > 0))
                {
                    <div>@item.Item.Name</div>
                    <div style="text-align:right;">@item.CastCounter</div>
                }
            </div>
        </CollapsibleSection>
    }

    @if (_activeSession is not null && _activeSession.Turns.Count > 2)
    {
        <CollapsibleSection Title="@Text.Turns" IsCollapsed="true">
            <BarGraph Max="(_activeSession.Turns.Where(t => t.Time is not null).Max(t => t.Time!.Value.TotalMinutes) * 1.1d)"
                      Points="TurnsToLineGraphPoints(_activeSession.Turns)"
                      Marked="_settings.PreferredTurnLength.TotalMinutes"
                      Height="200"></BarGraph>
        </CollapsibleSection>
    }

    <EditEffect EffectToEdit="_editActiveEffect" 
        SaveEditCallback="@(async x => await FinishEditingActiveEffect(true))"
        Stats="_settings.Stats"
        Dice="_settings.Dice"></EditEffect>

    @if (_quickEffect is not null)
    {
        <dialog id="quick-effect" popover>
            <h4>@(_quickEffect.Outcome == EffectOutcome.Reduces ? Text.Damage : Text.Heal)</h4>
            <InputWithLabel Label="@(_quickEffect.Outcome == EffectOutcome.Reduces ? Text.DamageFor : Text.HealFor)">
                <InputNumber @bind-Value="_quickEffect.Strength"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="@Text.To">
                <InputSelect @bind-value="_quickEffect.Target">
                    <option value="@EffectTarget.Health">@Text.Health</option>
                    <option value="@EffectTarget.Mana">@Text.Mana</option>
                </InputSelect>
            </InputWithLabel>
            <button popovertarget="quick-effect" popovertargetaction="hide">@Text.Cancel</button>
            <button style="float:right;" popovertarget="quick-effect" popovertargetaction="hide" @onclick="async x => await ExecuteQuickEffect()">@Text.OK</button>
        </dialog>
    }

    <dialog id="take-rest" popover>
        <h4>@Text.Rest</h4>
        <button popovertarget="take-rest" popovertargetaction="hide">@Text.Cancel</button>
        <button style="float:right;" popovertarget="take-rest" popovertargetaction="hide" @onclick="async x => await Rest()">@Text.OK</button>
    </dialog>

    @if (_editMoney is not null)
    {
        <dialog id="edit-money" popover>
            <h4>@_editMoney.Item.Name</h4>
            <InputWithLabel Label="@Text.Quantity">
                <InputNumber @bind-Value="_editMoney.Quantity"></InputNumber>
            </InputWithLabel>
            <button style="float:right;" popovertarget="edit-money" popovertargetaction="hide" @onclick="async x => await Rest()">@Text.Save</button>
        </dialog>
    }
</div>

@if (_diceRollQueue.Any())
{
    <div class="effect-stack">
        <div class="effect-stack-content">
            <div style="grid-column:span 2;">
                <EffectView Model="_diceRollQueue.First()" Modifiers="_activeCharacter.GetModifiers(_settings.ScoreModifierTable)"></EffectView>
            </div>
            <div style="grid-column:span 2;">
                @Text.Roll @_diceRollQueue.First().NumberOfDice @_diceRollQueue.First().DiceType
            </div>
            <div>@Text.DiceResult</div>
            <InputNumber @bind-Value="_effectDiceResult"></InputNumber>
            <div></div>
            <button @onclick="async x => await ExecuteQueuedEffect()">@Text.Confirm</button>
        </div>
    </div>
}

@code {
    private Settings _settings = new Settings();
    private Character _activeCharacter = new Character();
    private (int Current, int Required) _experienceToNextLevel = (0, 300);

    private Session? _activeSession;
    private UpCountingTimer? _timer;
    private Turn? _activeTurn;

    private Effect? _editActiveEffect;
    private Effect? _quickEffect;
    private CharacterMoney? _editMoney;

    private List<Effect> _diceRollQueue => _activeCharacter.GetDiceEffectQueue();
    private int _effectDiceResult;

    protected override void OnInitialized()
    {
        _timer = new UpCountingTimer(UpdateUi);
    }

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        _activeCharacter = await ContentService.LoadCharacter(_settings.ActiveCharacter);
        if (string.IsNullOrWhiteSpace(_settings.ActiveCharacter))
        {
            _settings.ActiveCharacter = _activeCharacter.Id;
            await ContentService.SaveSettings(_settings);
        }
        _experienceToNextLevel = _settings.LevelThresholdTable.ExperienceToNextLevel(_activeCharacter.ExperiencePoints);

        _timer = new UpCountingTimer(UpdateUi);
        var sessions = await ContentService.LoadSessions();
        _activeSession = sessions.FirstOrDefault(s => s.EndTime is null) ?? new Session();

        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;
    }

    private void UpdateUi(object? state)
    {
        StateHasChanged();
    }

    private async Task StartTurn()
    {
        if (_activeSession is null)
        {  
            _activeSession = new();
            await ContentService.SaveSession(_activeSession);
        }
        _timer ??= new UpCountingTimer(UpdateUi);

        _activeTurn = new Turn() { Character = _activeCharacter };
        _activeSession.Turns.Add(_activeTurn);
        await ContentService.SaveSession(_activeSession);

        await ExecuteActiveEffects(false);
        _timer.StartTimer();

        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task EndTurn()
    {
        if (_activeSession is null || _timer is null || _activeTurn is null)
            return;

        await ExecuteActiveEffects(true);
        _timer!.StopTimer();

        _activeTurn.Time = _timer.Time;
        _activeTurn = null;
        await ContentService.SaveSession(_activeSession);

        _activeCharacter.ActiveEffects.Where(x => x.Duration is EffectDuration.Turns && x.Turns < 1).Select(async e => await _activeCharacter.RemoveActiveEffect(e));
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task UseSpell(Spell spell, bool useOnYourself)
    {
        if (spell.ManaCost > _activeCharacter.Mana)
        {
            await ContentService.MakeAlert(Text.NotEnoughMana);
            return;
        }
        await _activeCharacter.UseSpell(spell.Id, useOnYourself, _activeCharacter.GetModifiers(_settings.ScoreModifierTable));
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task UseEquipment(Equipment equipment, bool useOnYourself)
    {
        await _activeCharacter.UseEquipmentItem(equipment.Id, useOnYourself, _activeCharacter.GetModifiers(_settings.ScoreModifierTable));
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task ToggleEquip(Gear gear)
    {
        await _activeCharacter.EquipGear(gear.Id);
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task UseGear(Gear equipment, bool useOnYourself)
    {
        await _activeCharacter.UseGear(equipment.Id, useOnYourself, _activeCharacter.GetModifiers(_settings.ScoreModifierTable));
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task ExecuteActiveEffects(bool isEndOfTurn)
    {
        await _activeCharacter.ExecuteActiveEffects(isEndOfTurn, _activeCharacter.GetModifiers(_settings.ScoreModifierTable));
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task ExecuteQueuedEffect()
    {
        await _activeCharacter.ExecuteDiceRoll(_diceRollQueue.First(), _effectDiceResult, _activeCharacter.GetModifiers(_settings.ScoreModifierTable));
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task Rest()
    {
        await _activeCharacter.Rest();
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task StartEditingMoney(CharacterMoney money)
        => _editMoney = money;

    private async Task FinishEditingMoney()
    {
        _editMoney = null;
        await ContentService.SaveCharacter(_activeCharacter);
    }

    #region Quick Effect
    private void StartQuickEffect(bool isDamaging)
        => _quickEffect = new Effect()
            {
                EffectType = EffectType.Active,
                Duration = EffectDuration.Instant,
                Outcome = isDamaging ? EffectOutcome.Reduces : EffectOutcome.Increases
            };

    private async Task ExecuteQuickEffect()
    {
        if (_quickEffect is null)
            return;
        await _activeCharacter.UseQuickEffect(_quickEffect);
        _quickEffect = null;
        await ContentService.SaveCharacter(_activeCharacter);
    }
    #endregion

    #region Active Effects
    private void AddNewActiveEffect()
    {
        var effect = new Effect() { EffectType = EffectType.Active, Duration = EffectDuration.UntilRemoved };
        effect.Name = $"{Text.Effect} {_activeCharacter.ActiveEffects.Count + 1}";
        StartEditingActiveEffect(effect);
    }

    private void StartEditingActiveEffect(Effect effect)
        => _editActiveEffect = effect;

    private async Task FinishEditingActiveEffect(bool save)
    {
        if (_editActiveEffect is null)
            return;

        if (save && !_activeCharacter.ActiveEffects.Any(e => e.Id == _editActiveEffect.Id))
            await _activeCharacter.AddActiveEffect(_editActiveEffect);

        _editActiveEffect = null;
        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task RemoveActiveEffect(Effect effect)
    {
        await _activeCharacter.RemoveActiveEffect(effect);
        await ContentService.SaveCharacter(_activeCharacter);
    }
    #endregion

    private static IEnumerable<LineGraphPoint<double>> TurnsToLineGraphPoints(List<Turn> turns)
    {
        var turnText = turns.Count < 5 ? Text.Turn : turns.Count < 9 ? Text.TurnShort : null;
        return turns.Where(t => t.Time.HasValue).Select(t => new LineGraphPoint<double>() { Label = turnText is not null ? $"{turnText} {turns.IndexOf(t) + 1}" : null, Value = t.Time!.Value.TotalMinutes });
    }
}