@page "/settings"
@using Codespirals.Blazor.Services
@using DNDHinwil.Models
@using DNDHinwil.Website.Components.Generic
@using DNDHinwil.Website.Extensions
@inject IDataService ContentService
@inject IUserInteractionService UserInteractionService

<PageTitle>@Constants.SiteName - @Text.Settings</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header class="title">
        <h2>@Text.Settings</h2>
    </header>
    <section class="settings">
        <h3>@Text.General</h3>
        <InputWithLabel Label="@Text.AccentColor">
            <InputSelect @bind-value="_settings.AccentColor">
                <option value="#ff8533">@Text.Default</option>
                @foreach (var color in _colors)
                {
                    <option value="@color.Color" style="@($"background-color:{@color.Color};")">@color.Name</option>
                }
            </InputSelect>
        </InputWithLabel>
        <InputWithLabel Label="@Text.Language">
            <InputSelect @bind-value="_settings.Language">
                @foreach (var language in Constants.ImplementedLanguages.Split(';'))
                {
                    <option value="@language">@language</option>
                }
            </InputSelect>
        </InputWithLabel>
    </section>
    <section>
        <h3>@Text.GameSettings</h3>
        <InputWithLabel Label="@Text.MeleeRange">
            <InputNumber @bind-value="_settings.MeleeRange"></InputNumber>
        </InputWithLabel>
        <InputWithLabel Label="@Text.TimerMarkedTime">
            <InputNumber @bind-value="_settings.PreferredTurnLengthInMinutes"></InputNumber>
        </InputWithLabel>
    </section>
    <section>
        <button @onclick="async x => await SaveSettings()" style="width:100%;">@Text.Save</button>
    </section>
    <section class="export">
        <h3 style="grid-column:span 2;">@Text.Export</h3>
        <div>@Text.DownloadCharacters</div>
        <button command="show-modal" commandfor="character-selection" @onclick="async x => await StartSelectingCharacters()">@Text.Download</button>
        <div>@Text.DownloadSpells</div>
        <button command="show-modal" commandfor="spell-selection" @onclick="async x => await StartSelectingSpells()">@Text.Download</button>
        <div>@Text.DownloadGear</div>
        <button command="show-modal" commandfor="gear-selection" @onclick="async x => await StartSelectingGear()">@Text.Download</button>
        <div>@Text.DownloadEquipment</div>
        <button command="show-modal" commandfor="equipment-selection" @onclick="async x => await StartSelectingEquipment()">@Text.Download</button>
    </section>
    <section class="import">
        <h3 style="grid-column:span 2;">@Text.Import</h3>
        <div>@Text.UploadCharacters</div>
        <button command="show-modal" commandfor="file-import" @onclick="x => _fileType = FileType.Characters">@Text.Upload</button>
        <div>@Text.UploadSpells</div>
        <button command="show-modal" commandfor="file-import" @onclick="x => _fileType = FileType.Spells">@Text.Upload</button>
        <div>@Text.UploadGear</div>
        <button command="show-modal" commandfor="file-import" @onclick="x => _fileType = FileType.Gear">@Text.Upload</button>
        <div>@Text.UploadEquipment</div>
        <button command="show-modal" commandfor="file-import" @onclick="x => _fileType = FileType.Equipment">@Text.Upload</button>
    </section>
    <section class="export import"> 
        <div>@Text.Save</div>
        <button command="show-modal" commandfor="backup">@Text.Download</button>
        <div>Load</div>
        <button command="show-modal" commandfor="file-import" @onclick="x => _fileType = FileType.Backup">@Text.Upload</button>
    </section>
    <section class="tables">
        <h3 style="grid-column:span 2;">Tables</h3>
        <div class="levels">
            <h4 style="grid-column:span 2;">@Text.ExperienceTable</h4>
            <div>@Text.Experience</div>
            <div>@Text.Level</div>
            @foreach (var row in _settings.LevelThresholdTable)
            {
                <div>@row.TotalExperience</div>
                <div>@row.Level</div>
            }
        </div>
        <div class="modifiers">
            <h4 style="grid-column:span 2;">@Text.ModifierTable</h4>
            <div>@Text.Score</div>
            <div>@Text.Modifier</div>
            @foreach (var row in _settings.ScoreModifierTable)
            {
                <div>@row.Score</div>
                <div>@row.Modifier</div>
            }
        </div>
        <div class="dice">
            <h4 style="grid-column:span 2;">@Text.Dice</h4>
            <div>@Text.Value</div>
            <div>@Text.Name</div>
            @foreach (var item in _settings.Dice)
            {
                <div>@item.Value</div>
                <div>@item.Name</div>
            }
        </div>
    </section>

    <dialog id="character-selection" class="export-dialog">
        <h4>@Text.Select</h4>
        <ListItemSelector Selections="_selectedCharacters"></ListItemSelector>
        <button command="close" commandfor="character-selection" @onclick="DownloadCharacters">@Text.Confirm</button>
    </dialog>
    <dialog id="spell-selection" class="export-dialog">
        <h4>@Text.Select</h4>
        <ListItemSelector Selections="_selectedSpells"></ListItemSelector>
        <button command="close" commandfor="spell-selection" @onclick="DownloadSpells">@Text.Confirm</button>
    </dialog>
    <dialog id="equipment-selection" class="export-dialog">
        <h4>@Text.Select</h4>
        <ListItemSelector Selections="_selectedEquipment"></ListItemSelector>
        <button command="close" commandfor="equipment-selection" @onclick="DownloadEquipment">@Text.Confirm</button>
    </dialog>
    <dialog id="gear-selection" class="export-dialog">
        <h4>@Text.Select</h4>
        <ListItemSelector Selections="_selectedGear"></ListItemSelector>
        <button command="close" commandfor="gear-selection" @onclick="DownloadGear">@Text.Confirm</button>
    </dialog>
    <dialog id="backup" class="export-dialog">
        <h4>@Text.Name</h4>
        <InputText @bind-Value="_backupName"></InputText>
        <button command="close" commandfor="backup" @onclick="DownloadBackup">@Text.Confirm</button>
    </dialog>
    <dialog id="file-import" class="export-dialog">
        <h4>@Text.Select</h4>
        <InputFile OnChange="SetFile"></InputFile>
        <button command="close" commandfor="file-import" @onclick="UploadFile">@Text.Confirm</button>
    </dialog>
</div>

<script>
  window.downloadFileFromStream = async (fileName, contentStreamReference) => {
    const arrayBuffer = await contentStreamReference.arrayBuffer();
    const blob = new Blob([arrayBuffer]);
    const url = URL.createObjectURL(blob);
    const anchorElement = document.createElement('a');
    anchorElement.href = url;
    anchorElement.download = fileName ?? '';
    anchorElement.click();
    anchorElement.remove();
    URL.revokeObjectURL(url);
  }
</script>

@code {
    private Settings _settings = new Settings();

    private List<Selectable<Character>>? _selectedCharacters;
    private List<Selectable<Spell>>? _selectedSpells;
    private List<Selectable<Equipment>>? _selectedEquipment;
    private List<Selectable<Gear>>? _selectedGear;

    private bool _isLoading;
    private IBrowserFile? _file;
    private FileType _fileType = FileType.Characters;

    private string _backupName = "Campaign";

    private readonly (string Color, string Name)[] _colors = 
    [
        ("#9c1203", "Red"), 
        ("#e3a000", "Yellow"), 
        ("#033807", "Green"), 
        ("#00165e", "Blue")
    ];

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;
    }

    private async Task SaveSettings()
        => await ContentService.SaveSettings(_settings);

    private async Task DownloadFile<TItem>(string fileName, List<TItem> items)
    {
        if (string.IsNullOrWhiteSpace(fileName) || items is null || !items.Any())
            return;
    }

    private async Task StartSelectingCharacters()
        => _selectedCharacters = (await ContentService.LoadCharacters()).Select(i => new Selectable<Character>(){ Item = i}).ToList();

    private async Task DownloadBackup()
    {
        var campaign = new Campaign()
            {
                Name = _backupName,
                Characters = await ContentService.LoadCharacters(),
                Armory = await ContentService.LoadArmory(),
                EquipmentChest = await ContentService.LoadEquipmentChest(),
                SpellLibrary = await ContentService.LoadSpellLibrary(),
                Settings = await ContentService.LoadSettings()
            };
        await UserInteractionService.DownloadDataAsJson(campaign, $"dnd_{_backupName}");
    }
    private async Task DownloadCharacters()
    {
        if (_selectedCharacters is null)
            return;
        await UserInteractionService.DownloadDataAsJson(_selectedCharacters.Where(i => i.Selected).Select(c => c.Item), $"dnd_{Text.Characters}");
        _selectedCharacters = null;
    }

    private async Task StartSelectingSpells()
        => _selectedSpells = (await ContentService.LoadSpellLibrary()).Select(i => new Selectable<Spell>() { Item = i }).ToList();

    private async Task DownloadSpells()
    {
        if (_selectedSpells is null)
            return;
        await UserInteractionService.DownloadDataAsJson(_selectedSpells.Where(i => i.Selected).Select(c => c.Item), $"dnd_{Text.Spells}");
        _selectedSpells = null;
    }

    private async Task StartSelectingEquipment()
        => _selectedEquipment = (await ContentService.LoadEquipmentChest()).Select(i => new Selectable<Equipment>() { Item = i }).ToList();

    private async Task DownloadEquipment()
    {
        if (_selectedEquipment is null)
            return;
        await UserInteractionService.DownloadDataAsJson(_selectedEquipment.Where(i => i.Selected).Select(c => c.Item), $"dnd_{Text.Equipment}");
        _selectedEquipment = null;
    }

    private async Task StartSelectingGear()
        => _selectedGear = (await ContentService.LoadArmory()).Select(i => new Selectable<Gear>() { Item = i }).ToList();

    private async Task DownloadGear()
    {
        if (_selectedGear is null)
            return;
        await UserInteractionService.DownloadDataAsJson(_selectedGear.Where(i => i.Selected).Select(c => c.Item), $"dnd_{Text.Gear}");
        _selectedGear = null;
    }

    private async Task SetFile(InputFileChangeEventArgs e)
        => _file = e.File;

    private async Task UploadFile()
    {
        if (_file is null)
            return;
        switch(_fileType)
        {
            case FileType.Characters:
                await UploadCharacters();
                break;
            case FileType.Spells:
                await UploadSpells();
                break;
            case FileType.Gear:
                await UploadGear();
                break;
            case FileType.Equipment:
                await UploadEquipment();
                break;
            case FileType.Backup:
                await UploadBackup();
                break;
            default:
                break;
        }
    }

    private async Task UploadCharacters()
    {
        if (_file is null)
            return;
        var data = await GetItemsFromFile<List<Character>>(_file);
        if (data is null || !data.Any())
            return;
        var old = await ContentService.LoadCharacters();
        await ContentService.SaveCharacters(old.Integrate(data));
        await UserInteractionService.MakeAlert($"Successfully imported {data.Count} character(s).");
    }
    private async Task UploadEquipment()
    {
        if (_file is null)
            return;
        var data = await GetItemsFromFile<List<Equipment>>(_file);
        if (data is null || !data.Any())
            return;
        var old = await ContentService.LoadEquipmentChest();
        await ContentService.SaveEquipmentChest(old.Integrate(data));
        await UserInteractionService.MakeAlert($"Successfully imported {data.Count} equipment item(s).");
    }
    private async Task UploadGear()
    {
        if (_file is null)
            return;
        var data = await GetItemsFromFile<List<Gear>>(_file);
        if (data is null || !data.Any())
            return;
        var old = await ContentService.LoadArmory();
        await ContentService.SaveArmory(old.Integrate(data));
        await UserInteractionService.MakeAlert($"Successfully imported {data.Count} gear item(s).");
    }
    private async Task UploadSpells()
    {
        if (_file is null)
            return;
        var data = await GetItemsFromFile<List<Spell>>(_file);
        if (data is null || !data.Any())
            return;
        var old = await ContentService.LoadSpellLibrary();
        await ContentService.SaveSpellLibrary(old.Integrate(data));
        await UserInteractionService.MakeAlert($"Successfully imported {data.Count} spell(s).");
    }
    private async Task UploadBackup()
    {
        if (_file is null)
            return;
        var data = await GetItemsFromFile<Campaign>(_file, int.MaxValue);
        if (data is null)
            return;
        await ContentService.SaveCampaign(data);
        await UserInteractionService.MakeAlert($"Successfully imported backup.");
    }

    private async Task<T?> GetItemsFromFile<T>(IBrowserFile file, int maxFileSize = 1048576)
    {
        _isLoading = true;
        try
        {
            var data = await UserInteractionService.ExtractDataFromJsonFile<T>(file, maxFileSize);
            if (data is null)
                return default;
            return data;
        }
        catch (Exception ex)
        {
            await UserInteractionService.MakeAlert($"Unexpected error while reading file.");
            Console.WriteLine(ex.Message);
            return default;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private enum FileType
    {
        Characters,
        Spells,
        Equipment,
        Gear,
        Backup
    }
}
