@page "/library"
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - @Text.SpellLibrary</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header>
        <h2>@Text.SpellLibrary</h2>
    </header>

    <CollapsibleSection Title="@($"{@Text.SpellbookOf} {_activeCharacter.Name}")">
        @{var modifiers = _activeCharacter.CalculateModifiers(_settings.ScoreModifiers);}
        @foreach (var spell in _activeCharacter.Spellbook)
        {
            <div class="spellbook-spell">
                <SpellOrAbility Model="spell" Modifiers="modifiers" MeleeRange="_settings.MeleeRange"></SpellOrAbility>
                <button class="right-button" @onclick="async x => await RemoveSpellFromSpellbook(spell)">@Constants.Symbol_RemoveFromInventory</button>
            </div>
        }
    </CollapsibleSection>

    <CollapsibleSection Title="@Text.AvailableSpells">
        @foreach (var spell in _spellLibrary.Reverse<Spell>())
        {
            <div class="library-spell">
                <button class="left-button" command="show-modal" commandfor="delete-spell" @onclick="x => StartEditingSpell(spell)">@Constants.Symbol_Delete</button>
                <SpellOrAbility Model="spell" MeleeRange="_settings.MeleeRange"></SpellOrAbility>
                <button class="right-button" command="show-modal" commandfor="edit-spell" @onclick="x => StartEditingSpell(spell)">@Constants.Symbol_Edit</button>
                <button class="right-button" @onclick="async x => await AddSpellToSpellbook(spell)">@Constants.Symbol_AddToInventory</button>
            </div>
        }
        <button command="show-modal" commandfor="edit-spell" @onclick="x => AddNewSpell()" style="width:100%;height:32px;margin-top:0.5rem;">@Text.NewSpell</button>
    </CollapsibleSection>

    @if (_editSpell is not null)
    {
        <dialog id="edit-spell" class="edit-spell">
            <h3>@Text.Spell</h3>
            <InputWithLabel Label="@Text.Name">
                <InputText @bind-Value="_editSpell.Name"></InputText>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Range">
                <InputNumber @bind-Value="_editSpell.Range"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="@Text.ManaCost">
                <InputNumber @bind-Value="_editSpell.ManaCost"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="@Text.CanBeUsedOnSelf">
                <InputCheckbox @bind-Value="_editSpell.CanBeUsedOnSelf"></InputCheckbox>
            </InputWithLabel>
            <div class="edit-spell-effects">
                <h4 style="width:100%;grid-column:span 2;">@Text.Effects</h4>
                @if (_editSpell.Effects.Any())
                {
                    @foreach (var effect in _editSpell.Effects)
                    {
                        <div class="spell-effect">
                            <button class="left-button" @onclick="x => RemoveEffect(effect)">@Constants.Symbol_Delete</button>
                            <div class="effect-text">@effect.ToString()</div>
                            <button class="right-button" @onclick="x => StartEditingEffect(effect)" command="show-modal" commandfor="edit-effect">@Constants.Symbol_Edit</button>
                        </div>
                    }
                }
                else
                {
                    <div class="spell-effect">@Text.NoEffects</div>
                }
                <button @onclick="x => AddNewEffect()" command="show-modal" commandfor="edit-effect" style="width:100%;grid-column:span 2;margin-top:0.5rem;">@Text.NewSpellEffect</button>
            </div>
            <button @onclick="x => FinishEditingSpell(false)" command="close" commandfor="edit-spell">@Text.Cancel</button>
            <button @onclick="x => FinishEditingSpell(true)" command="close" commandfor="edit-spell" style="float:right;">@Text.Save</button>
        </dialog>
    }

    <dialog id="delete-spell">
        <h3>@Text.RemoveSpellFromLibrary</h3>
        <label>@Text.AreYouSure</label>
        <button @onclick="async x => await FinishEditingSpell(false)" command="close" commandfor="delete-spell">@Text.Cancel</button>
        <button @onclick="async x => await DeleteSpell(_editSpell)" command="close" commandfor="delete-spell">@Text.Confirm</button>
    </dialog>

    <EditEffect EffectToEdit="_editEffect"
                OnClickCallback="@(async x => await FinishEditingEffect(true))"
                Stats="_activeCharacter.Stats"
                Dice="_settings.Dice"></EditEffect>
</div>

@code {
    private Settings _settings = new Settings();
    private Character _activeCharacter = new Character();
    private List<Spell> _spellLibrary = [];

    private Spell? _editSpell;
    private Effect? _editEffect;

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        _activeCharacter = await ContentService.LoadCharacter(_settings.ActiveCharacter);
        _spellLibrary = await ContentService.LoadSpellLibrary();

        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;
    }

    #region Library
    // C
    private void AddNewSpell()
    {
        var spell = new Spell();
        spell.Name = $"{Text.Spell} {_spellLibrary.Count + 1}";
        StartEditingSpell(spell);
    }
    // R
    private void StartEditingSpell(Spell spell)
        => _editSpell = spell;
    // U
    private async Task FinishEditingSpell(bool save)
    {
        if (_editSpell is null)
            return;
        if (!save)
        {
            _editSpell = null;
            return;
        }
        var spellExists = _spellLibrary.FirstOrDefault(s => s.Id == _editSpell.Id);
        if (spellExists is not null)
            _spellLibrary.Remove(spellExists);

        _spellLibrary.Add(_editSpell);
        await ContentService.SaveSpellLibrary(_spellLibrary);
        _editSpell = null;
    }
    // D
    private async Task DeleteSpell(Spell? spell)
    {
        if (spell is null)
            return;
        _spellLibrary.Remove(spell);
        await ContentService.SaveSpellLibrary(_spellLibrary);
    }
    #endregion

    #region Spellbook
    private async Task AddSpellToSpellbook(Spell spell)
    {
        var spellAlreadyInBook = _activeCharacter.Spellbook.FirstOrDefault(s => s.Id == spell.Id);
        if (spellAlreadyInBook is not null)
            _activeCharacter.Spellbook.Remove(spellAlreadyInBook);
        _activeCharacter.Spellbook.Add(spell);

        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task RemoveSpellFromSpellbook(Spell spell)
    {
        _activeCharacter.Spellbook.RemoveAt(_activeCharacter.Spellbook.FindIndex(sc => sc.Id == spell.Id));
        await ContentService.SaveCharacter(_activeCharacter);
    }
    #endregion

    #region Effects
    // C
    private void AddNewEffect()
    {
        var effect = new Effect() { EffectType = EffectType.Active };
        StartEditingEffect(effect);
    }

    // R
    private void StartEditingEffect(Effect effect)
        => _editEffect = effect;

    // U
    private async Task FinishEditingEffect(bool save)
    {
        if (_editSpell is null || _editEffect is null)
            return;
        if (!save)
        {
            _editEffect = null;
            return;
        }
        // remove old version
        var effectExists = _editSpell.Effects.FirstOrDefault(e => e.Id == _editEffect.Id);
        if (effectExists is not null)
            _editSpell.Effects.Remove(effectExists);

        _editSpell.Effects.Add(_editEffect);

        await ContentService.SaveSpellLibrary(_spellLibrary);
        _editEffect = null;
    }

    // D
    private async Task RemoveEffect(Effect effect)
    {
        if (_editSpell is null)
            return;
        _editSpell.Effects.Remove(effect);
        await ContentService.SaveSpellLibrary(_spellLibrary);
    }
    #endregion
}