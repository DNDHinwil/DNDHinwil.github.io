@page "/equipment"
@inject IDataService ContentService

<PageTitle>@Constants.SiteName - @Text.EquipmentChest</PageTitle>

<div class="content" style="@($"--color-primary:{_settings.AccentColor};")">
    <header class="title">
        <h2>@Text.Equipment</h2>
    </header>
    <CollapsibleSection Title="@Text.InventoryOf.Replace("{{CHARACTER}}", _activeCharacter.Name)">
        @foreach (var equipment in _activeCharacter.Inventory)
        {
            <div class="inventory-item">
                <button class="left-button" @onclick="x => RemoveEquipmentFromInventory(equipment, true)">@Constants.Symbol_Delete</button>
                <EquipmentItem Model="equipment" Modifiers="_activeCharacter.CalculateModifiers(_settings.ScoreModifiers)"></EquipmentItem>
                <button class="right-button" @onclick="x => RemoveEquipmentFromInventory(equipment, false)">@Constants.Symbol_RemoveFromInventory</button>
            </div> 
        }
    </CollapsibleSection>
    <CollapsibleSection Title="@Text.EquipmentChest">
        <h3 style="grid-column:span 3;">@Text.EquipmentChest</h3>
        @foreach (var equipment in _equipmentChest)
        {
            <div class="equipment-chest-item">
                <button class="left-button" command="show-modal" commandfor="delete-equipment" @onclick="x => StartEditingEquipment(equipment)">@Constants.Symbol_Delete</button>
                <EquipmentItem Model="equipment" HideQuantity="true" Modifiers="_activeCharacter.CalculateModifiers(_settings.ScoreModifiers)"></EquipmentItem>
                <button class="right-button" command="show-modal" commandfor="edit-equipment" @onclick="x => StartEditingEquipment(equipment)">@Constants.Symbol_Edit</button>
                <button class="right-button" @onclick="async x => await AddEquipmentToInventory(equipment)">@Constants.Symbol_AddToInventory</button>
            </div>
        }
        <button command="show-modal" commandfor="edit-equipment" @onclick="x => AddNewEquipment()" style="width:100%;grid-column:span 3;margin-top:0.5rem;">@Text.NewEquipment</button>
    </CollapsibleSection>

    @if (_editEquipment is not null)
    {
        <dialog id="edit-equipment" class="edit-equipment">
            <h3>@Text.Equipment</h3>
            <InputWithLabel Label="@Text.Name">
                <InputText @bind-Value="_editEquipment.Name"></InputText>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Description">
                <InputText @bind-Value="_editEquipment.Description"></InputText>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Weight">
                <InputNumber @bind-Value="_editEquipment.Weight"></InputNumber>
            </InputWithLabel>
            <InputWithLabel Label="@Text.Usable">
                <InputCheckbox @bind-Value="_editEquipment.Usable"></InputCheckbox>
            </InputWithLabel>
            @if (_editEquipment.Usable)
            {
                <InputWithLabel Label="@Text.DecreasesWithUse">
                    <InputCheckbox @bind-Value="_editEquipment.DecreasesWithUse"></InputCheckbox>
                </InputWithLabel>
                <InputWithLabel Label="@Text.CanBeUsedOnSelf">
                    <InputCheckbox @bind-Value="_editEquipment.CanBeUsedOnSelf"></InputCheckbox>
                </InputWithLabel>
                <InputWithLabel Label="@Text.DropWhenEmpty">
                    <InputCheckbox @bind-Value="_editEquipment.DropWhenEmpty"></InputCheckbox>
                </InputWithLabel>
            }
            <div class="edit-equipment-effects">
                <h4 style="width:100%;">@Text.Bonuses</h4>
                @if (_editEquipment.Effects.Any())
                {
                    @foreach (var effect in _editEquipment.Effects)
                    {
                        <div class="equipment-effect">
                            <button class="left-button" @onclick="x => RemoveEffect(effect)">@Constants.Symbol_Delete</button>
                            <div class="effect-text">@effect.ToString()</div>
                            <button class="right-button" @onclick="x => StartEditingEffect(effect)" command="show-modal" commandfor="edit-effect">@Constants.Symbol_Edit</button>
                        </div>
                    }
                }
                else
                {
                    <div style="width:100%;grid-column:span 3;">@Text.NoBonuses</div>
                }
                <button @onclick="x => AddNewEffect()" command="show-modal" commandfor="edit-effect" style="width:100%;margin-top:0.5rem;">@Text.NewEqupmentEffect</button>
            </div>
            <button @onclick="x => FinishEditingEqiupment(false)" command="close" commandfor="edit-equipment">@Text.Cancel</button>
            <button @onclick="x => FinishEditingEqiupment(true)" command="close" commandfor="edit-equipment" style="float:right;">@Text.Save</button>
        </dialog>
    }
    <dialog id="delete-equipment">
        <h3>@Text.RemoveGearFromInventory</h3>
        <label>@Text.AreYouSure</label>
        <button @onclick="async x => await FinishEditingEqiupment(false)" command="close" commandfor="delete-equipment">@Text.Cancel</button>
        <button @onclick="async x => await DeleteEquipment(_editEquipment)" command="close" commandfor="delete-equipment">@Text.Confirm</button>
    </dialog>

    <EditEffect EffectToEdit="_editEffect"
                OnClickCallback="@(async x => await FinishEditingEffect(true))"
                Stats="_activeCharacter.Stats"
                Dice="_settings.Dice"></EditEffect>
</div>

@code {
    private Settings _settings = new Settings();
    private Character _activeCharacter = new Character();
    private List<Equipment> _equipmentChest = [];

    private Equipment? _editEquipment;
    private Effect? _editEffect;

    protected override async Task OnInitializedAsync()
    {
        _settings = await ContentService.LoadSettings();
        _activeCharacter = await ContentService.LoadCharacter(_settings.ActiveCharacter);
        _equipmentChest = await ContentService.LoadEquipmentChest();

        var newCulture = new CultureInfo(_settings.Language);
        Thread.CurrentThread.CurrentUICulture = newCulture;
        Text.Culture = newCulture;
    }

    #region Equipment Chest
    // C
    private void AddNewEquipment()
    {
        var equipment = new Equipment();
        equipment.Name = $"{Text.Equipment} {_equipmentChest.Count + 1}";
        StartEditingEquipment(equipment);
    }
    // R
    private void StartEditingEquipment(Equipment equipment)
        => _editEquipment = equipment;
    // U
    private async Task FinishEditingEqiupment(bool save)
    {
        if (_editEquipment is null)
            return;
        if (!save)
        {
            _editEquipment = null;
            return;
        }
        var equipmentExists = _equipmentChest.FirstOrDefault(s => s.Id == _editEquipment.Id);
        if (equipmentExists is not null)
            _equipmentChest.Remove(equipmentExists);

        _equipmentChest.Add(_editEquipment);
        await ContentService.SaveEquipmentChest(_equipmentChest);
        _editEquipment = null;
    }
    // D
    private async Task DeleteEquipment(Equipment? equipment)
    {
        if (equipment is null)
            return;
        _equipmentChest.Remove(equipment);
        await ContentService.SaveEquipmentChest(_equipmentChest);
    }
    #endregion

    #region Inventory
    private async Task AddEquipmentToInventory(Equipment equipment)
    {
        var equipmentAlreadyInInventory = _activeCharacter.Inventory.FirstOrDefault(s => s.Id == equipment.Id);
        if (equipmentAlreadyInInventory is not null)
            equipmentAlreadyInInventory.Quantity++;
        else
            _activeCharacter.Inventory.Add(equipment);

        await ContentService.SaveCharacter(_activeCharacter);
    }

    private async Task RemoveEquipmentFromInventory(Equipment equipment, bool removeAll)
    {
        var equipmentAlreadyInInventory = _activeCharacter.Inventory.FirstOrDefault(s => s.Id == equipment.Id);
        if (equipmentAlreadyInInventory is null)
            return;
        if (removeAll)
            equipmentAlreadyInInventory.Quantity = 0;
        else
            equipmentAlreadyInInventory.Quantity--;

        if (equipmentAlreadyInInventory.Quantity < 1)
            _activeCharacter.Inventory.Remove(equipmentAlreadyInInventory);
        
        await ContentService.SaveCharacter(_activeCharacter);
    }
    #endregion

    #region Effects
    // C
    private void AddNewEffect()
    {
        var effect = new Effect() { EffectType = EffectType.Active };
        StartEditingEffect(effect);
    }

    // R
    private void StartEditingEffect(Effect effect)
        => _editEffect = effect;

    // U
    private async Task FinishEditingEffect(bool save)
    {
        if (_editEquipment is null || _editEffect is null)
            return;
        if (!save)
        {
            _editEffect = null;
            return;
        }
        // remove old version
        var effectExists = _editEquipment.Effects.FirstOrDefault(e => e.Id == _editEffect.Id);
        if (effectExists is not null)
            _editEquipment.Effects.Remove(effectExists);

        _editEquipment.Effects.Add(_editEffect);

        await ContentService.SaveEquipmentChest(_equipmentChest);
        _editEffect = null;
    }

    // D
    private async Task RemoveEffect(Effect effect)
    {
        if (_editEquipment is null)
            return;
        _editEquipment.Effects.Remove(effect);
        await ContentService.SaveEquipmentChest(_equipmentChest);
    }
    #endregion
}