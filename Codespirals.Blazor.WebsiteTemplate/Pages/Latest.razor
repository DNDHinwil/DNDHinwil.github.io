@page "/posts/latest"
@inject IContentService ContentService

<PageTitle>@Constants.SiteName - Latest</PageTitle>

<div class="content">
    <Post Model="Model"></Post>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "";
    private BlogPost? Model { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Model = await ContentService.GetLatest();
    }
}